# OKX DEX aggregator (quote + RFQ). Server-only. Get keys at
# https://web3.okx.com/build/dev-portal
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_PROJECT_ID=

# Optional. Backed / xStocks primary (xChange). KYC client key from the issuer platform.
# Without this, Issue/Redeem shows the issuer print and wrap only — it will not fake a mint.
XSTOCKS_API_KEY=

# Privy embedded wallet (email OTP, TEE keys, same address on any device).
# Create a free app at https://dashboard.privy.io
# Enable Email login. Allowed origins: http://127.0.0.1:3000 and your production URL.
# Default chain: X Layer (196).
NEXT_PUBLIC_PRIVY_APP_ID=

# Weesh fee + gas tank. Same wallet receives 0.05% on swaps and drips OKB
# so users never hold gas. Fund this address with a little OKB on X Layer.
NEXT_PUBLIC_WEESH_TREASURY=0x46D5486731fEe2539146883e1B3c80B2c8ac60E3
WEESH_GAS_KEY=

# Send-to-many contract on X Layer. Defaults to the deployed WeeshDrop if unset.
NEXT_PUBLIC_WEESH_DROP=0x76960502d4d84381fab3ec48be229342631fc33f
